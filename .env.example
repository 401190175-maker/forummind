# ForumMind 本地开发环境变量示例
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交。
# 注意：只有 NEXT_PUBLIC_ 前缀的变量会进入浏览器，请勿在此放置服务端密钥。

# --- 后端 API (apps/api) ---
# API 监听地址
API_HOST=0.0.0.0
# API 监听端口（默认 8000）
API_PORT=8000
# 运行环境（development / production）
ENVIRONMENT=development
# 允许跨域访问的前端来源，多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:3000
# SQLite 数据库路径（留空时默认为 apps/api/data/forummind.db）
FORUMMIND_DB_PATH=apps/api/data/forummind.db

# --- 前端 Web (apps/web) ---
# 前端访问后端 API 的基础地址（浏览器可访问的地址）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- LLM Provider (apps/api) ---
# OpenAI-compatible 服务端点（默认阿里云百炼 DashScope）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM API key：仅存于 apps/api/.env（勿提交、勿写入代码）
LLM_API_KEY=
# 模型名（默认 qwen-plus）
LLM_MODEL=qwen-plus

# --- Pi Agent Runtime (apps/api) ---
# Agent runtime selection: replay, legacy_llm, mock, or pi
AGENT_RUNTIME=replay
# 是否允许 AGENT_RUNTIME=pi（默认关闭）
PI_ENABLED=false
# Pi 使用的模型标识（启用 Pi 时必填）
PI_MODEL=
# Pi Sidecar/service 地址；进程内 transport 可为空
PI_BASE_URL=
# Pi 或其模型服务密钥（勿提交、勿写入前端）
PI_API_KEY=
# 单个 Agent 调用超时时间（秒）
PI_TIMEOUT_SECONDS=60
# 单个 Agent 调用允许的最大轮次
PI_MAX_TURNS=8

# --- Docker Compose (docker-compose.yml) ---
# compose 从根目录 .env 读取变量：ENVIRONMENT 与 CORS_ORIGINS 由 compose 转发给 api
# 容器并带有默认值；API_HOST / API_PORT 为文档契约（容器内不消费，见 docker-compose.yml）：
#   未设置时使用默认值，无需额外配置即可 `docker compose up --build`。
# NEXT_PUBLIC_API_BASE_URL 是 web 镜像的构建期 ARG（next build 时内联进客户端
# bundle），compose 通过 build.args 传入，不在运行期 environment 中设置。

# Native Pi Runtime sidecar (required when AGENT_RUNTIME=pi/live/auto)
PI_RUNTIME_TOKEN=
PI_RUNTIME_URL=http://pi-runtime:8010
PI_CONTROL_PLANE_URL=http://api:8000
PI_PROVIDER=openai-compatible
PI_SESSION_ROOT=/var/lib/forummind/pi-sessions
PI_MAX_CONCURRENCY_PER_GROUP=2
PI_MAX_TOOL_CALLS_PER_RUN=24
PI_MAX_RESULT_BYTES=65536
PI_MAX_REQUEST_BYTES=262144
PI_MAX_SSE_BUFFER=256
PI_PROMPT_TIMEOUT_MS=120000
