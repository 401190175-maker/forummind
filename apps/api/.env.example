# ForumMind API backend environment example. Do not put secrets in source control.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
FORUMMIND_DB_PATH=apps/api/data/forummind.db

# Use pi only after all Pi prerequisites are configured.
AGENT_RUNTIME=replay
PI_ENABLED=false
PI_MODEL=
PI_BASE_URL=
PI_API_KEY=
PI_RUNTIME_URL=http://127.0.0.1:8010
PI_RUNTIME_TOKEN=
PI_PROVIDER=openai-compatible
PI_CONTROL_PLANE_URL=http://127.0.0.1:8000
PI_TIMEOUT_SECONDS=60
PI_MAX_CONCURRENCY_PER_GROUP=2
PI_MAX_TOOL_CALLS_PER_RUN=24
PI_MAX_RESULT_BYTES=65536
PI_MAX_SSE_BUFFER=256
