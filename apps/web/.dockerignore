*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---- VCS 与 IDE / OS 缓存 ----
.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db
